# ============================================================
# AI Forecast Bust Detection — environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ============================================================

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Default prototype runs on SQLite (zero setup). For PostgreSQL use:
# postgresql+psycopg://forecast_dev:password@localhost:5432/forecast_bust
DATABASE_URL=sqlite:///./backend/forecast_bust.db

# --- ML ---
MODEL_PATH=./ml/models
NWP_DATA_PATH=./data/raw
OBSERVATION_DATA_PATH=./data/raw

# --- Data quality / freshness ---
FORECAST_FRESHNESS_HOURS=30

# --- Risk thresholds (bust probability bands) ---
RISK_VERY_HIGH=0.8
RISK_HIGH=0.6
RISK_MODERATE=0.4
RISK_LOW=0.2

# --- Alerting ---
ALERT_PROBABILITY_THRESHOLD=0.6

# --- NWP ingestion: NOAA/NCEP GFS via NOMADS ---
# Public service, no API key. Backend retrieves GFS directly from NOAA.
GFS_BASE_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GFS_DATASET=gfs
# Geographic sub-region (India). Omit GFS_USE_BOUNDS=1 for a global download.
GFS_LEFT_LON=68
GFS_RIGHT_LON=98
GFS_BOTTOM_LAT=6
GFS_TOP_LAT=38
# Forecast hours to retrieve
GFS_FORECAST_START=0
GFS_FORECAST_END=120
GFS_FORECAST_INTERVAL=3
# Variables: any subset of TMP,APCP,UGRD,VGRD,RH,PRES
GFS_VARIABLES=TMP,APCP,UGRD,VGRD,RH
GFS_INCLUDE_PRESSURE=1
# Update loop
GFS_UPDATE_INTERVAL_MINUTES=30
# Grace period after a cycle's nominal time before probing NOMADS
GFS_CYCLE_DELAY_HOURS=3
# Start the background updater inside the FastAPI lifespan (0 = off)
GFS_AUTO_UPDATE=0
# HTTP client
GFS_HTTP_TIMEOUT=120
GFS_MAX_RETRIES=3
GFS_BACKOFF_BASE=2.0
GFS_REQUEST_DELAY=1.0
# Storage
GFS_RAW_DIR=./data/raw/gfs
GFS_PROCESSED_DIR=./data/processed/gfs
GFS_RETENTION_DAYS=3

# --- Redis (optional, unused by MVP) ---
REDIS_URL=

# --- Frontend (Vite; prefix VITE_) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
